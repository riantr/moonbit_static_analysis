// mermaid: render a scan as a mermaid `stateDiagram-v2`, for a downstream
// agent to read rather than a human to skim.
//
// The spine of each file's box is the trust chain — lexed, then the three
// inspections in order — because that is the order the numbers in a verdict
// mean. A file the frontend did not finish stops at the line it stopped at,
// and the findings past that line are counted and never drawn. Every finding
// becomes its own state hung off the inspection that reported it, carrying a
// note that says why the code was judged wrong and what to change.
//
// Two rules this file is written around, both established by measurement:
//
//   1. MoonBit has NO operator continuation. A source line that begins with
//      `+` is a parse error, so every multi-line output is written one
//      `write_string` at a time. (An earlier draft of this file used the
//      leading-`+` idiom throughout and did not parse.)
//   2. A transition label in mermaid is everything after the FIRST `:`, so a
//      label may not contain one. Locations and messages therefore live in
//      the quoted STATE label, never in the transition.
//
// Truncation is always announced. `per_file` and `max_files` both take `0`
// for "no cap"; whatever a cap leaves out is stated in a note and in the
// header, and the header distinguishes the summary (which describes the whole
// scan) from the drawing (which may be a subset).

///|
/// One file as a composite state.
///
/// `per_file` caps how many findings become their own node, `max_files` caps
/// how many files become composite states at all (files are taken in order of
/// descending ACTIONABLE count, so a capped diagram leads with the files worth
/// reading). Both take `0` for "no cap".
///
/// `summary` describes the WHOLE scan and is printed as given; when `max_files`
/// trims the drawing, the header says so explicitly, because a diagram that
/// silently showed a subset would let a clean-looking file read as a clean
/// file.
///
/// `prov.version` and `prov.scanned_at` are repeated in the header, not just
/// in the filename: a file gets renamed, and once it does the name is no
/// longer evidence of anything. Empty ones print as `unknown` rather than
/// being dropped.
pub fn mermaid_states(
  verdicts : Array[Verdict],
  summary : Summary,
  prov : ScanProvenance,
  per_file : Int,
  max_files : Int,
) -> String {
  let target = prov.target
  let out = StringBuilder()
  out.write_string("stateDiagram-v2\n")
  out.write_string("    direction TB\n")
  out.write_string(
    "    %% generated by @sa.mermaid_states — read the trust chain, not the counts\n",
  )
  out.write_string("    %% target=" + sanitize(target) + "\n")
  out.write_string("    %% version=\{prov_or_unknown(prov.version)}\n")
  out.write_string("    %% moonbit=\{prov_or_unknown(prov.moonbit)}\n")
  out.write_string(
    "    %% scanned_at=\{prov_or_unknown(prov.scanned_at)} (UTC)\n",
  )
  out.write_string("    %% files=\{verdicts.length()}")
  out.write_string(
    " parsed=\{summary.parsed_files} partial=\{summary.partial_files}",
  )
  out.write_string(
    " actionable=\{summary.actionable} notices=\{summary.notices}",
  )
  out.write_string(
    " unreliable=\{summary.unreliable} withheld=\{summary.withheld}",
  )
  out.write_string(" total=\{summary.total}\n")
  let picked = pick_files(verdicts, max_files)
  if picked.length() < verdicts.length() {
    out.write_string("    %% THIS DRAWING IS A SUBSET: ")
    out.write_string(
      "\{picked.length()} of \{verdicts.length()} files, chosen by descending ACTIONABLE count.",
    )
    out.write_string(" A file not drawn is NOT a file with no findings.\n")
  }
  out.write_string("\n")
  out.write_string("    state \"scan — " + sanitize(target) + " — ")
  out.write_string(
    "\{verdicts.length()} files scanned, \{summary.actionable} actionable\" as scan\n",
  )
  for i in picked {
    let fid = file_id(i)
    let v = verdicts[i]
    let detail = if v.parsed {
      "parsed"
    } else if v.region_line > 0 {
      "PARTIAL, trusted to line \{v.region_line}"
    } else {
      "not understood"
    }
    let head = "\{v.findings.length() - v.notices} actionable, " +
      "\{v.notices} notice(s), "
    out.write_string("    scan --> " + fid + " : " + head + detail + "\n")
    emit_file(out, fid, v, per_file)
  }
  out.to_string()
}

///|
/// Indices of the files to draw. `0` keeps every file in the order the scan
/// produced them, which is the order the scanner walked. A positive
/// `max_files` keeps the first `max_files` of the ACTIONABLE ranking below.
fn pick_files(verdicts : Array[Verdict], max_files : Int) -> Array[Int] {
  let idx : Array[Int] = []
  for i, _ in verdicts {
    idx.push(i)
  }
  if max_files <= 0 || idx.length() <= max_files {
    return idx
  }
  // Rank by ACTIONABLE findings, not by raw findings. Measured on
  // moonbitlang/core: the largest raw-finding file is a 402-finding test file
  // that is 402 notices and zero defects, and ranking by raw count put it
  // first in a diagram whose whole job is to lead with what to fix.
  // Ties break on raw findings, then on scan order, so the output is stable.
  idx.sort_by(fn(a : Int, b : Int) {
    let va = verdicts[a]
    let vb = verdicts[b]
    let da = va.findings.length() - va.notices
    let db = vb.findings.length() - vb.notices
    if da != db {
      if da > db {
        -1
      } else {
        1
      }
    } else {
      let fa = va.findings.length()
      let fb = vb.findings.length()
      if fa != fb {
        if fa > fb {
          -1
        } else {
          1
        }
      } else if a < b {
        -1
      } else if a > b {
        1
      } else {
        0
      }
    }
  })
  // Array has no `slice`; take the head by position.
  let head = []
  for i, v in idx {
    if i < max_files {
      head.push(v)
    }
  }
  head
}

///|
/// A notice is not a defect, and the drawing has to agree with the numbers it
/// prints beside it. `Verdict.notices` is filled by counting exactly this
/// family, and `actionable` is `findings.length() - notices`, so using any
/// other predicate here would let the diagram draw a defect as a notice (or
/// the reverse) while the same node reported the opposite total.
fn is_notice(rep : @report.Report) -> Bool {
  rep.family == @core.FParse
}

///|
fn emit_file(
  out : StringBuilder,
  fid : String,
  v : Verdict,
  per_file : Int,
) -> Unit {
  let defects = v.findings.length()
  out.write_string("    state \"\{fid} — \{sanitize(v.path)}\" as \{fid} {\n")
  out.write_string("        direction TB\n")
  // The spine. A file that was not understood stops the chain at the reason it
  // stopped — that is the whole point of `region_line`, and drawing the
  // inspections past it would imply findings the tool explicitly withheld.
  out.write_string("        [*] --> \{fid}_lex\n")
  out.write_string("        state \"lexed\" as \{fid}_lex\n")
  let parsed_note = if v.parsed {
    "whole file read"
  } else {
    sanitize(v.reason)
  }
  out.write_string("        \{fid}_lex --> \{fid}_struct : \{parsed_note}\n")
  out.write_string(
    "        state \"inspection 1/3 — structural\" as \{fid}_struct\n",
  )
  out.write_string("        \{fid}_struct --> \{fid}_type : inspection 2/3\n")
  out.write_string("        state \"inspection 2/3 — type\" as \{fid}_type\n")
  out.write_string("        \{fid}_type --> \{fid}_behav : inspection 3/3\n")
  out.write_string(
    "        state \"inspection 3/3 — behavioral\" as \{fid}_behav\n",
  )
  if v.region_line > 0 && !v.parsed {
    // The trust boundary. Findings from here on are counted, never drawn.
    out.write_string(
      "        \{fid}_behav --> [*] : \{v.unreliable} withheld past the boundary\n",
    )
  } else {
    out.write_string("        \{fid}_behav --> [*]\n")
  }
  if v.notices > 0 {
    let head = if v.notices == 1 {
      "1 finding on this file is a NOTICE, not a defect: a declaration form this"
    } else {
      "\{v.notices} of the findings on this file are NOTICES: a declaration form this"
    }
    note(out, "\{fid}_struct", [
      head, "analyzer does not model was skipped whole. They are excluded from the",
      "actionable count.",
    ])
  }
  if v.unreliable > 0 {
    let head = if v.unreliable == 1 {
      "1 further finding on this file sits at or after line \{v.region_line},"
    } else {
      "\{v.unreliable} further findings on this file sit at or after line \{v.region_line},"
    }
    note(out, "\{fid}_behav", [
      head, "where the tree is already wrong. They are counted as unreliable and",
      "deliberately NOT drawn: they measure the analyzer's blindness, not your code.",
    ])
  }
  // One state per finding, hung off the inspection that reported it.
  let limit = cap(per_file, defects)
  let counts = Map([])
  let mut notices_dropped = 0
  for k, rep in v.findings {
    if k < limit {
      let notice = is_notice(rep)
      // A notice gets its own id prefix as well as its own label. The label
      // is what a human reads; the id is what a downstream agent greps, and
      // before this the two were indistinguishable in both. On a scan of this
      // analyzer's own source, `f8` drew one NOTICE and two DEFECTs as the
      // same shape carrying the same note, so the only way to tell them apart
      // was to already know that the family name FParse means notice.
      let eid = if notice { "\{fid}_n\{k}" } else { "\{fid}_e\{k}" }
      let lens = primary_lens(rep.lenses)
      let tag = if notice { "notice" } else { "defect" }
      // The transition label carries only the family: it is everything after
      // the first `:`, so a location or message containing a colon would
      // otherwise be truncated mid-string by the parser.
      out.write_string(
        "        \{fid}_\{lens} --> \{eid} : \{tag} \{rep.family.name()}\n",
      )
      let where_ = "@\{rep.span.start.line}:\{rep.span.start.col}"
      let lead = if notice { "NOTICE — " } else { "" }
      out.write_string(
        "        state \"\{lead}\{rep.family.name()} \{where_} — \{sanitize(rep.message)}\" as \{eid}\n",
      )
      if notice {
        // No WHY/HOW here, and that is the point of the split. The advice for
        // FParse is written for the first genuine read failure — which never
        // reaches this loop, because everything from the boundary on is
        // counted and not drawn. Attaching it here gave a notice the same
        // "here is what to change" weight as a defect while describing
        // something that is not there.
        //
        // What is true for EVERY file kind, and so is all this claims: the
        // accounting. FParse is counted in `notices` and subtracted from
        // `actionable`, and it means a form this analyzer does not model on
        // `.mbt`, or a per-file-kind frontend rule on the others.
        note(out, eid, [
          "NOTICE — counted in `notices`, excluded from `actionable`.", "ParseError covers a form this analyzer does not model and a per-file-kind",
          "frontend rule. The message above says which; do not read it as a defect",
          "just because it is drawn like one.",
        ])
      } else {
        let a = rep.family.advice()
        let body = ["WHY: " + a.why, "HOW: " + a.how]
        if rep.lenses.length() > 1 {
          body.push(
            "SEEN BY: " +
            lens_list(rep.lenses) +
            " — the lenses agree, so this is not one lens guessing.",
          )
        }
        note(out, eid, body)
      }
    } else if is_notice(rep) {
      notices_dropped += 1
    } else {
      let key = primary_lens(rep.lenses)
      let n = match counts.get(key) {
        Some(x) => x
        None => 0
      }
      counts.set(key, n + 1)
    }
  }
  let dropped = defects - limit
  if dropped > 0 {
    // Say what was left out, per inspection, so a truncated diagram cannot be
    // read as a clean one.
    let mut parts = ""
    for _, key in counts.keys() {
      if parts != "" {
        parts = parts + ", "
      }
      match counts.get(key) {
        Some(n) => parts = parts + n.to_string() + " from " + key
        None => ()
      }
    }
    // "caps a file at N" is kept on ONE line: a note is line-based, so a phrase
    // split across two lines stops existing as a phrase — and the reader (or a
    // downstream agent grepping for it) needs it intact.
    let head = if dropped == 1 {
      "1 further finding on this file was NOT drawn, because this"
    } else {
      "\{dropped} further findings on this file were NOT drawn, because this"
    }
    let body = [
      head,
      "diagram caps a file at \{limit}. Per inspection: " + parts + ".",
      "Re-run with per_file = 0 for the complete set.",
    ]
    // The per-inspection breakdown above counts defects only. A file whose
    // dropped findings are mostly notices would otherwise report a defect
    // breakdown that does not add up to the number just quoted.
    if notices_dropped > 0 {
      let nt = if notices_dropped == 1 {
        "1 of them is a NOTICE, excluded from `actionable`."
      } else {
        "\{notices_dropped} of them are NOTICES, excluded from `actionable`."
      }
      body.push(nt)
    }
    note(out, "\{fid}_struct", body)
  }
  out.write_string("    }\n")
}

///|
/// A mermaid `note` block. The body is written one line at a time for the
/// reason in the file header, and each line is guarded because a line reading
/// exactly `end note` would close the note early.
fn note(out : StringBuilder, anchor : String, body : Array[String]) -> Unit {
  out.write_string("        note right of \{anchor}\n")
  for line in body {
    out.write_string("            " + guard_note(line) + "\n")
  }
  out.write_string("        end note\n")
}

///|
fn guard_note(line : String) -> String {
  if line.trim() == "end note" {
    "'end note' (quoted: literal text)"
  } else {
    line
  }
}

///|
/// `limit` capped at `n`, with `0` meaning no cap.
fn cap(limit : Int, n : Int) -> Int {
  if limit <= 0 {
    n
  } else if limit < n {
    limit
  } else {
    n
  }
}

///|
/// Which inspection a finding is hung off: the FIRST lens that saw it, in lens
/// order. A merged finding (all three lenses) belongs to the structural pass,
/// because that is the first one that ran.
fn primary_lens(lenses : Array[@core.Lens]) -> String {
  let sorted = by_rank(lenses)
  match sorted[0] {
    @core.LStructural => "struct"
    @core.LType => "type"
    @core.LBehavior => "behav"
  }
}

///|
/// The lens tag of a finding, in inspection order — "structural+type+behavior"
/// for one all three lenses saw.
fn lens_list(lenses : Array[@core.Lens]) -> String {
  let names = []
  for l in by_rank(lenses) {
    if !names.contains(l.name()) {
      names.push(l.name())
    }
  }
  names.join("+")
}

///|
fn by_rank(lenses : Array[@core.Lens]) -> Array[@core.Lens] {
  let sorted = lenses.copy()
  sorted.sort_by(fn(a : @core.Lens, b : @core.Lens) {
    if a.rank() < b.rank() {
      -1
    } else if a.rank() > b.rank() {
      1
    } else {
      0
    }
  })
  sorted
}

///|
fn file_id(i : Int) -> String {
  "f" + i.to_string()
}

///|
/// Make a string safe to sit inside a mermaid quoted label: no `"` (it would
/// close the label), no newline (labels are one line), and no `;` (it ends a
/// statement). A label is a human-readable summary, so losing a quote is
/// preferable to a diagram that will not parse.
fn sanitize(s : String) -> String {
  let buf = StringBuilder()
  for c in s {
    if c == '"' {
      buf.write_char('\'')
    } else if c == '\n' || c == '\r' || c == '\t' {
      buf.write_char(' ')
    } else if c == ';' {
      buf.write_char(',')
    } else {
      buf.write_char(c)
    }
  }
  buf.to_string()
}
