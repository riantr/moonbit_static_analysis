// Cross-project scanning logic. A LIBRARY, not an entrypoint: the module's root
// package is the executable, and a main package importing another main package
// is deprecated ("Move reusable APIs into a non-main package and keep main
// packages as entrypoints").
//
// Needs the async runtime (file IO + `moon fetch`), which only some backends
// provide: wasm and native do; js has none, and wasm-gc wants a
// `run_async_main` that async 0.22.4 does not export. Naming the supported set
// makes check/test on those backends SKIP this package instead of failing.
supported_targets = "+wasm+native"

// The async runtime now comes from the toolchain-bundled `moonbitlang/core`
// module, and `moonbitlang/core/async` is EXPERIMENTAL there. The standalone
// `moonbitlang/async` module was stable and had to be pinned; this one needs
// no pin at all, which is the point of the swap -- and it still has to be
// acknowledged, or the build refuses it.

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
    "moonbitlang/core/async/process",
  ],
)

import {
  "riantr/moonbit_static_analysis/src/pipeline",
  "riantr/moonbit_static_analysis/src/moonfiles",
  "riantr/moonbit_static_analysis/src/parser",
  "riantr/moonbit_static_analysis/src/report",
  "riantr/moonbit_static_analysis/src/core",
  "moonbitlang/core/env",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
}
