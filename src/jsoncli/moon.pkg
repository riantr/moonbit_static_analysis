// JSON bridge: one JSON request in, one JSON reply out.
//
// `--file <path>` reads the request from disk, which needs async file IO. That
// puts this package on the wasm/native side of the fence: the js backend has no
// async runtime, so it cannot read a file. The reason for `--file` is that
// Windows caps the WHOLE command line at 32,767 characters -- not each argument
// -- so a request carrying a source over roughly 30 KB cannot be passed inline
// at all, and splitting it across several arguments does not help. In
// moonbit_doubleML 27 of 180 files are over 30 KB. Consumers run this bridge
// through `moonrun`, which they already need for the scanner.
pkgtype(kind: "executable")

supported_targets = "+wasm+native"

// `moonbitlang/core/async` is EXPERIMENTAL in the toolchain-bundled core
// module. The standalone `moonbitlang/async` module was stable and had to be
// pinned; this one is bundled with the toolchain the user already has.

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
)

import {
  "riantr/moonbit_static_analysis/src/pipeline",
  "riantr/moonbit_static_analysis/src/statecheck",
  "riantr/moonbit_static_analysis/src/moonfiles",
  "riantr/moonbit_static_analysis/src/report",
  "riantr/moonbit_static_analysis/src/core",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
}
