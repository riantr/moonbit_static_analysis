// JSON bridge: one JSON request in, one JSON reply out.
//
// `--file <path>` reads the request from disk, which needs async file IO. That
// puts this package on the wasm/native side of the fence: the js backend has no
// async runtime, so it cannot read a file. The reason for `--file` is that
// Windows caps the WHOLE command line at 32,767 characters -- not each argument
// -- so a request carrying a source over roughly 30 KB cannot be passed inline
// at all, and splitting it across several arguments does not help. In
// moonbit_doubleML 27 of 180 files are over 30 KB. Consumers run this bridge
// through `moonrun`, which they already need for the scanner.
pkgtype(kind: "executable")

supported_targets = "+wasm+native"

// `moonbitlang/core/async` is EXPERIMENTAL in the toolchain-bundled core
// module. The standalone `moonbitlang/async` module was stable and had to be
// pinned; this one is bundled with the toolchain the user already has.

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/fs",
  ],
)

import {
  "riantr/moonbit_static_analysis/src/pipeline",
  "riantr/moonbit_static_analysis/src/flow",
  "riantr/moonbit_static_analysis/src/statecheck",
  "riantr/moonbit_static_analysis/src/moonfiles",
  "riantr/moonbit_static_analysis/src/report",
  "riantr/moonbit_static_analysis/src/core",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
}

// 0631. THE ASYNC RUNTIME IMPORT IS REQUIRED BY ONE CORE AND REDUNDANT UNDER
// THE OTHER, AND THIS TREE HAS TO BUILD ON BOTH.
//
// `moonbitlang/core/async` has to be imported for `async fn main` to compile:
// without it the core 0.10.21 says "Cannot use `async fn main`: package
// moonbitlang/async is not imported" (error 4122). The core 0.10.22 no longer
// needs the import, and reports it as `unused_package` (warning 0029) -- which
// `--deny-warn` turns into an error. So the import is REQUIRED by one
// toolchain and UNUSED by the other, and the tree has to build on both.
//
// The import STAYS and the warning is silenced HERE, in the two packages that
// declare an `async fn main`. The suppression is per package, not module-wide,
// so an import that is genuinely unused somewhere else still gets reported.
//
// MEASURED 2026-11-20: with the import and this line, both cores are green;
// without the import, core 0.10.21 fails with error 4122. The artifact does
// not move: 106 imports, 92 of them from `moonbitlang/async`.

warnings = "-unused_package"
