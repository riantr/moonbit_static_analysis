// 0604: THE HAND-MODELLED NATIVE SURFACE, AND THE DECLARED ONE IT IS MEASURED
// AGAINST.
//
// THE DECK. `Soundiness` (Yue Li and Tian Tan, Nanjing University, 2021 Fall),
// p.57, on native code:
//
//     Current practice
//     Manually models the critical native code
//
// p.58-59 give the reason the modelling exists at all -- the behaviour is
// implemented natively for speed:
//
//     For efficiency, arraycopy() is implemented in native code
//
// p.60-61 give the ALTERNATIVE modelling -- the same behaviour written out in
// the high-level language instead of modelled by hand:
//
//     An alternative modeling
//     System.arraycopy(src, sp, dest, dp, ln);
//     Java
//     for(int i = 0; i < ln; i++)
//     dest[dp+i] = src[sp+i];
//
// p.62 gives the analysis's own view of it -- "pointer analysis's view" -- and
// p.63 names the newer way of reading the truth:
//
//     Recent work
//     Identifying Java Calls in Native Code via Binary Scanning (ISSTA 2020)
//
// THE ANALOGUE IN THIS TREE. The analyzer hand-models a slice of the built-in
// surface: `src/core/builtin_methods.mbt` is a TABLE of `Type::method` names,
// generated by `tools/gen_builtin_methods.ps1` out of the toolchain's own
// interfaces, and stamped with the toolchain it was last read against.
//
// AND THE DECLARED SURFACE is what the interfaces say those types have. The
// two are measured against each other here, and the direction of the error
// matters, because the table only ever SUPPRESSES:
//
//     a name it HOLDS that the toolchain has DROPPED  -> a MISSED report
//     a name it LACKS that the toolchain DECLARES    -> a FALSE POSITIVE
//
// The second is the one that hurts, and it is the one the table's own header
// is explicit about.
//
// SO THE MEASUREMENT IS FIVE NUMBERS AND NOT ONE RATIO, because a ratio would
// hide the direction: `covered` over `declared` says how much of the DECLARED
// surface the table carries, and `modelled_only` says how much of the table
// the target does not declare at all. Those are two different questions and a
// single percentage cannot answer both.

///|
/// THE COVERAGE OF THE HAND-MODELLED SURFACE, measured against the DECLARED
/// one.
///
/// AND THE FIVE NUMBERS ARE FIVE DIFFERENT QUESTIONS, so they are five fields
/// rather than one ratio.
pub(all) struct NativeSurface {
  /// The hand-modelled table's size: how many names it holds.
  modelled : Int32
  /// The methods the TARGET's own interfaces declare for the modelled types.
  declared : Int32
  /// Of those, the ones the hand-modelled table holds.
  covered : Int32
  /// Of those, the ones it does NOT hold -- the false positives waiting, IF
  /// the interfaces are not available to carry them.
  missing : Int32
  /// The table's own names the target no longer declares: the missed reports
  /// the table has already accepted, in the direction it accepts.
  modelled_only : Int32
}

///|
/// THE TYPES the hand-modelled table covers, which are the types it names
/// methods of.
pub fn builtin_type_names() -> Array[String] {
  let out : Array[String] = []
  for name in builtin_method_names() {
    let t = type_prefix(name)
    if t != "" && !out.contains(t) {
      out.push(t)
    }
  }
  out
}

///|
/// THE COVERAGE, measured over a set of DECLARED value names.
///
/// AND THE DECLARED NAMES COME FROM THE TARGET'S OWN INTERFACES, and not from
/// the whole cross-package table: the question is what the TARGET declares
/// about the built-in types, and a table that merges every fetched package's
/// interfaces cannot answer it.
pub fn native_surface_coverage(declared : Array[String]) -> NativeSurface {
  let modelled = builtin_method_names()
  let types = builtin_type_names()
  // The declared methods of the modelled types, and nothing else: a function
  // of some other package's own type is not part of the built-in surface.
  let decl : Array[String] = []
  for name in declared {
    if !name.contains("::") {
      continue
    }
    let t = type_prefix(name)
    if t != "" && types.contains(t) && !decl.contains(name) {
      decl.push(name)
    }
  }
  let mut covered = 0
  let mut missing = 0
  for name in decl {
    if modelled.contains(name) {
      covered += 1
    } else {
      missing += 1
    }
  }
  // The other direction: the table's names the target no longer declares.
  let mut modelled_only = 0
  for name in modelled {
    if !decl.contains(name) {
      modelled_only += 1
    }
  }
  NativeSurface::{
    modelled: modelled.length(),
    declared: decl.length(),
    covered,
    missing,
    modelled_only,
  }
}

///|
/// The TYPE a `Type::method` name belongs to, or "" when the name is not
/// qualified.
///
/// IT IS THE HEAD of a `::` name, and `path_tail` in `core.mbt` is the TAIL
/// of one: the two answer different questions about the same spelling, and
/// neither is a second implementation of the other.
pub fn type_prefix(name : String) -> String {
  match name.find("::") {
    None => ""
    Some(i) => if i <= 0 { "" } else { name[0:i].to_owned() }
  }
}
