// The module's ROOT package: a thin forwarder to `src/sa`.
//
// It exists so `moonx riantr/moonbit_static_analysis@latest <target>` works
// without naming a package — an unpinned `moonx <module>` resolves the root
// package, and with no root executable it fails with "Prebuilt wasm asset does
// not exist". No other package in this module depends on the root, and nothing
// outside the module imports the bare module path.
//
// Like `src/sa`, it needs the async runtime, which only works on some
// backends; see the note there.
supported_targets = "+wasm+native"

pkgtype(kind: "executable")

// `moonbitlang/core/async` is an EXPERIMENTAL package in the toolchain-bundled
// `moonbitlang/core` module, and using it has to be acknowledged here. The
// alternative -- the standalone `moonbitlang/async` module -- is stable, and
// this is the trade this swap makes: one fewer dependency to pin, at the price
// of depending on a package the core team still marks experimental. See the
// comment in `moon.mod` for the measurement behind the swap.

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)

import {
  "riantr/moonbit_static_analysis/src/sa",
  "moonbitlang/core/async",
  "moonbitlang/core/env",
}
