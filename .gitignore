# build artifacts
_build/

# vendored registry dependencies materialised by `moon update` / `moon add`, and
# by `moonx <target>` when the target is a registry coordinate (it runs
# `moon fetch`, which drops the package under `.repos/`).
# NOT ours to commit: it is a copy of someone else's published source, and
# `git add -A` will happily stage thousands of files of it. (Learned the hard
# way — a release commit once swept in the whole of moonbitlang/async.)
.mooncakes/
.repos/

# local formal-verification toolchain shims (machine-specific paths)
.why3.conf
cvc5wrap.ps1

# scratch logs from measurement runs (scan output dumps, big-tree timings).
# Evidence, not source: the numbers quoted in the docs are already recorded in
# EXTENSIONS.md, and these files are megabytes of per-file listing.
_qa/

# The mooncakes credential. `git add -A` staged it once before .moonignore
# existed; the token inside is live. The copy CI needs is a GitHub Actions
# secret, not a file in the tree. .moonignore covers the publish side of this.
credentials.json
*.credentials.json
